{
  "dashboard": {
    "title": ".NET API Dashboard",
    "panels": [
      {
        "gridPos": {"h": 8, "w": 6, "x": 0, "y": 0},
        "title": "Request Rate",
        "type": "stat",
        "targets": [{
          "expr": "rate(http_requests_received_total[1m])",
          "legendFormat": "req/sec"
        }],
        "fieldConfig": {
          "defaults": {"unit": "reqps"}
        }
      },
      {
        "gridPos": {"h": 8, "w": 6, "x": 6, "y": 0},
        "title": "Error Rate",
        "type": "stat",
        "targets": [{
          "expr": "sum(rate(http_requests_received_total{code=~\"5..\"}[5m])) / sum(rate(http_requests_received_total[5m])) * 100",
          "legendFormat": "5xx %"
        }],
        "fieldConfig": {
          "defaults": {"unit": "percent"}
        }
      },
      {
        "gridPos": {"h": 8, "w": 6, "x": 12, "y": 0},
        "title": "P95 Latency",
        "type": "stat",
        "targets": [{
          "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket[5m])) * 1000",
          "legendFormat": "ms"
        }],
        "fieldConfig": {
          "defaults": {"unit": "ms"}
        }
      },
      {
        "gridPos": {"h": 8, "w": 6, "x": 18, "y": 0},
        "title": "Memory Usage",
        "type": "gauge",
        "targets": [{
          "expr": "process_private_memory_bytes / 1024 / 1024",
          "legendFormat": "MB"
        }],
        "fieldConfig": {
          "defaults": {
            "unit": "MB",
            "min": 0,
            "max": 500,
            "thresholds": {
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 300},
                {"color": "red", "value": 400}
              ]
            }
          }
        }
      },
      {
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
        "title": "HTTP Requests Over Time",
        "type": "timeseries",
        "targets": [{
          "expr": "rate(http_requests_received_total[1m])",
          "legendFormat": "{{method}} {{code}}"
        }]
      },
      {
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
        "title": "Response Time",
        "type": "timeseries",
        "targets": [
          {"expr": "histogram_quantile(0.50, rate(http_request_duration_seconds_bucket[5m])) * 1000", "legendFormat": "P50"},
          {"expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket[5m])) * 1000", "legendFormat": "P95"},
          {"expr": "histogram_quantile(0.99, rate(http_request_duration_seconds_bucket[5m])) * 1000", "legendFormat": "P99"}
        ],
        "fieldConfig": {
          "defaults": {"unit": "ms"}
        }
      },
      {
        "gridPos": {"h": 8, "w": 8, "x": 0, "y": 16},
        "title": "CPU Usage",
        "type": "gauge",
        "targets": [{
          "expr": "rate(process_cpu_seconds_total[5m]) * 100",
          "legendFormat": "%"
        }],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "thresholds": {
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 70},
                {"color": "red", "value": 90}
              ]
            }
          }
        }
      },
      {
        "gridPos": {"h": 8, "w": 8, "x": 8, "y": 16},
        "title": "Active Threads",
        "type": "stat",
        "targets": [{
          "expr": "process_num_threads",
          "legendFormat": "threads"
        }]
      },
      {
        "gridPos": {"h": 8, "w": 8, "x": 16, "y": 16},
        "title": "EF Core Queries",
        "type": "stat",
        "targets": [{
          "expr": "rate(microsoft_entityframeworkcore_microsoft_entityframeworkcore_queries[5m])",
          "legendFormat": "queries/sec"
        }]
      }
    ],
    "time": {"from": "now-1h", "to": "now"}
  }
}